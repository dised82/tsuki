{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tsuki",
  "version": "0.2.1",
  "identifier": "app.tsuki.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tsuki",
        "width": 1280,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "backgroundColor": "#0e0e10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Video",
    "shortDescription": "Lecteur hors ligne des VODs Twitch téléchargées avec Xtra",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-libav",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-good"
        ]
      }
    }
  }
}
